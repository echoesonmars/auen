{
  "$jsonSchema": {
      "bsonType": "object",
      "required": ["participants"],
      "properties": {
        "participants": {
          "bsonType": "array",
          "items": {
            "bsonType": "objectId"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Массив из 2 участников чата (обязательно)"
        },
        "lastMessage": {
          "bsonType": ["objectId", "null"],
          "description": "ID последнего сообщения в чате"
        },
        "lastMessageAt": {
          "bsonType": ["date", "null"],
          "description": "Дата и время последнего сообщения"
        },
        "createdAt": {
          "bsonType": ["date", "null"],
          "description": "Дата создания чата"
        },
        "updatedAt": {
          "bsonType": ["date", "null"],
          "description": "Дата обновления чата"
        }
      },
      "additionalProperties": true
    }
}

