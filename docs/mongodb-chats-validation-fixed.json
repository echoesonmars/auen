      },
      "createdAt": {
        "bsonType": ["date", "null"],
        "description": "Дата создания чата"
      },
      "updatedAt": {
        "bsonType": ["date", "null"],
        "description": "Дата обновления чата"
      }
    },
    "additionalProperties": true
