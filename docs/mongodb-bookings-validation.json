{
  "$jsonSchema": {
      "bsonType": "object",
      "required": ["adId", "renterId", "ownerId", "startDate", "endDate", "periodType", "totalPrice"],
      "properties": {
        "adId": {
          "bsonType": "objectId",
          "description": "ID объявления обязателен"
        },
        "renterId": {
          "bsonType": "objectId",
          "description": "ID арендатора обязателен"
        },
        "ownerId": {
          "bsonType": "objectId",
          "description": "ID владельца объявления обязателен"
        },
        "startDate": {
          "bsonType": "date",
          "description": "Дата начала бронирования обязательна"
        },
        "endDate": {
          "bsonType": "date",
          "description": "Дата окончания бронирования обязательна"
        },
        "startTime": {
          "bsonType": ["date", "null"],
          "description": "Время начала бронирования (опционально)"
        },
        "endTime": {
          "bsonType": ["date", "null"],
          "description": "Время окончания бронирования (опционально)"
        },
        "periodType": {
          "enum": ["hour", "day", "week", "month"],
          "description": "Тип периода бронирования: hour, day, week или month"
        },
        "totalPrice": {
          "bsonType": ["double", "int"],
          "minimum": 0,
          "description": "Общая стоимость бронирования (не может быть отрицательной)"
        },
        "status": {
          "enum": ["pending", "confirmed", "cancelled", "completed"],
          "description": "Статус бронирования: pending, confirmed, cancelled или completed"
        },
        "deliveryMethod": {
          "enum": ["pickup", "courier"],
          "description": "Способ доставки: pickup (самовывоз) или courier (курьер от Auen)"
        },
        "createdAt": {
          "bsonType": ["date", "null"],
          "description": "Дата создания"
        },
        "updatedAt": {
          "bsonType": ["date", "null"],
          "description": "Дата обновления"
        }
      },
      "additionalProperties": true
    }
}

