{
  "$jsonSchema": {
      "bsonType": "object",
      "required": ["chatId", "senderId", "receiverId", "text"],
      "properties": {
        "chatId": {
          "bsonType": "objectId",
          "description": "ID чата, к которому относится сообщение, обязателен"
        },
        "senderId": {
          "bsonType": "objectId",
          "description": "ID отправителя сообщения обязателен"
        },
        "receiverId": {
          "bsonType": "objectId",
          "description": "ID получателя сообщения обязателен"
        },
        "text": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Текст сообщения (от 1 до 2000 символов)"
        },
        "read": {
          "bsonType": ["bool", "null"],
          "description": "Прочитано ли сообщение (по умолчанию false)"
        },
        "createdAt": {
          "bsonType": ["date", "null"],
          "description": "Дата и время отправки сообщения"
        },
        "updatedAt": {
          "bsonType": ["date", "null"],
          "description": "Дата обновления сообщения"
        }
      },
      "additionalProperties": true
    }
}

