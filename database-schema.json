{
  "collections": {
    "users": {
      "fields": {
        "name": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 2,
            "maxlength": 50,
            "pattern": "^[а-яА-ЯёЁa-zA-Z\\s]+$",
            "message": "Имя может содержать только буквы, 2-50 символов"
          },
          "trim": true
        },
        "email": {
          "type": "String",
          "required": true,
          "unique": true,
          "validation": {
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "message": "Некорректный email адрес"
          },
          "lowercase": true,
          "trim": true,
          "index": true
        },
        "phone": {
          "type": "String",
          "required": true,
          "validation": {
            "pattern": "^\\+?[1-9]\\d{1,14}$",
            "message": "Некорректный номер телефона"
          }
        },
        "password": {
          "type": "String",
          "required": true,
          "select": false,
          "validation": {
            "minlength": 8,
            "message": "Пароль должен содержать минимум 8 символов"
          },
          "hash": true
        },
        "createdAt": {
          "type": "Date",
          "default": "Date.now"
        },
        "updatedAt": {
          "type": "Date",
          "default": "Date.now"
        }
      },
      "indexes": [
        { "email": 1 },
        { "createdAt": -1 }
      ]
    },
    "ads": {
      "fields": {
        "title": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 10,
            "maxlength": 100,
            "message": "Название должно содержать 10-100 символов"
          },
          "trim": true
        },
        "category": {
          "type": "String",
          "required": true,
          "enum": [
            "Инструменты",
            "Студии",
            "DJ оборудование",
            "Клавишные",
            "Микрофоны",
            "Аудио"
          ],
          "message": "Некорректная категория"
        },
        "description": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 50,
            "maxlength": 2000,
            "message": "Описание должно содержать 50-2000 символов"
          },
          "trim": true
        },
        "price": {
          "type": "String",
          "required": true,
          "validation": {
            "pattern": "^\\d+(\\s*₸)?\\s*\\/\\s*(час|день|неделя|месяц)$",
            "message": "Формат: 5000 ₸/час или 5000 ₸/день"
          }
        },
        "location": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 2,
            "maxlength": 50,
            "message": "Локация должна содержать 2-50 символов"
          },
          "trim": true
        },
        "images": {
          "type": ["String"],
          "default": [],
          "validation": {
            "maxlength": 10,
            "message": "Максимум 10 фотографий"
          }
        },
        "userId": {
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "index": true
        },
        "views": {
          "type": "Number",
          "default": 0,
          "validation": {
            "min": 0,
            "message": "Количество просмотров не может быть отрицательным"
          }
        },
        "status": {
          "type": "String",
          "enum": ["active", "inactive", "sold"],
          "default": "active",
          "message": "Некорректный статус",
          "index": true
        },
        "createdAt": {
          "type": "Date",
          "default": "Date.now"
        },
        "updatedAt": {
          "type": "Date",
          "default": "Date.now"
        }
      },
      "indexes": [
        { "userId": 1, "createdAt": -1 },
        { "category": 1, "status": 1 },
        { "location": 1 },
        { "createdAt": -1 },
        { "views": -1 }
      ]
    },
    "messages": {
      "fields": {
        "chatId": {
          "type": "ObjectId",
          "ref": "Chat",
          "required": true,
          "index": true
        },
        "senderId": {
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "index": true
        },
        "receiverId": {
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "index": true
        },
        "text": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 1,
            "maxlength": 2000,
            "message": "Сообщение должно содержать 1-2000 символов"
          },
          "trim": true
        },
        "read": {
          "type": "Boolean",
          "default": false
        },
        "createdAt": {
          "type": "Date",
          "default": "Date.now"
        }
      },
      "indexes": [
        { "chatId": 1, "createdAt": -1 },
        { "senderId": 1, "receiverId": 1 }
      ]
    },
    "chats": {
      "fields": {
        "participants": {
          "type": ["ObjectId"],
          "ref": "User",
          "required": true,
          "validation": {
            "length": 2,
            "message": "Чат должен содержать ровно 2 участника"
          }
        },
        "lastMessage": {
          "type": "ObjectId",
          "ref": "Message",
          "required": false
        },
        "lastMessageAt": {
          "type": "Date",
          "required": false
        },
        "createdAt": {
          "type": "Date",
          "default": "Date.now"
        }
      },
      "indexes": [
        { "participants": 1 },
        { "lastMessageAt": -1 }
      ]
    },
    "reviews": {
      "fields": {
        "userId": {
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "index": true
        },
        "adId": {
          "type": "ObjectId",
          "ref": "Ad",
          "required": true,
          "index": true
        },
        "rating": {
          "type": "Number",
          "required": true,
          "validation": {
            "min": 1,
            "max": 5,
            "message": "Рейтинг должен быть от 1 до 5"
          }
        },
        "comment": {
          "type": "String",
          "required": true,
          "validation": {
            "minlength": 10,
            "maxlength": 500,
            "message": "Отзыв должен содержать 10-500 символов"
          },
          "trim": true
        },
        "createdAt": {
          "type": "Date",
          "default": "Date.now"
        }
      },
      "indexes": [
        { "userId": 1, "adId": 1, "unique": true },
        { "adId": 1, "createdAt": -1 }
      ]
    }
  },
  "zodSchemas": {
    "register": {
      "name": {
        "type": "string",
        "min": 2,
        "max": 50,
        "regex": "^[а-яА-ЯёЁa-zA-Z\\s]+$",
        "message": "Имя должно содержать минимум 2 символа, только буквы"
      },
      "email": {
        "type": "string",
        "email": true,
        "message": "Некорректный email адрес"
      },
      "phone": {
        "type": "string",
        "regex": "^\\+?[1-9]\\d{1,14}$",
        "min": 10,
        "message": "Некорректный номер телефона"
      },
      "password": {
        "type": "string",
        "min": 8,
        "regex": [
          "[A-Z]",
          "[a-z]",
          "[0-9]"
        ],
        "messages": [
          "Пароль должен содержать хотя бы одну заглавную букву",
          "Пароль должен содержать хотя бы одну строчную букву",
          "Пароль должен содержать хотя бы одну цифру"
        ]
      },
      "confirmPassword": {
        "type": "string",
        "match": "password",
        "message": "Пароли не совпадают"
      },
      "agreeToTerms": {
        "type": "boolean",
        "required": true,
        "message": "Необходимо согласиться с условиями использования"
      }
    },
    "login": {
      "email": {
        "type": "string",
        "email": true,
        "message": "Некорректный email адрес"
      },
      "password": {
        "type": "string",
        "min": 1,
        "message": "Пароль обязателен"
      },
      "rememberMe": {
        "type": "boolean",
        "optional": true
      }
    },
    "createAd": {
      "title": {
        "type": "string",
        "min": 10,
        "max": 100,
        "message": "Название должно содержать 10-100 символов"
      },
      "category": {
        "type": "string",
        "enum": [
          "Инструменты",
          "Студии",
          "DJ оборудование",
          "Клавишные",
          "Микрофоны",
          "Аудио"
        ],
        "message": "Выберите категорию"
      },
      "description": {
        "type": "string",
        "min": 50,
        "max": 2000,
        "message": "Описание должно содержать 50-2000 символов"
      },
      "price": {
        "type": "string",
        "regex": "^\\d+(\\s*₸)?\\s*\\/\\s*(час|день|неделя|месяц)$",
        "message": "Формат: 5000 ₸/час или 5000 ₸/день"
      },
      "location": {
        "type": "string",
        "min": 2,
        "max": 50,
        "message": "Укажите локацию"
      },
      "images": {
        "type": "array",
        "max": 10,
        "message": "Максимум 10 фотографий",
        "optional": true
      }
    },
    "createMessage": {
      "receiverId": {
        "type": "string",
        "min": 1,
        "message": "Получатель обязателен"
      },
      "text": {
        "type": "string",
        "min": 1,
        "max": 2000,
        "message": "Сообщение должно содержать 1-2000 символов"
      }
    },
    "createReview": {
      "adId": {
        "type": "string",
        "min": 1,
        "message": "Объявление обязательно"
      },
      "rating": {
        "type": "number",
        "min": 1,
        "max": 5,
        "message": "Рейтинг должен быть от 1 до 5"
      },
      "comment": {
        "type": "string",
        "min": 10,
        "max": 500,
        "message": "Отзыв должен содержать 10-500 символов"
      }
    }
  }
}

